{
  "name": "sinobee.ai",
  "version": "0.2.0",
  "private": true,
  "description": "SinoBee official website: intro & install, Skill Hub, commissioned AI tasks, benchmarks",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node -e \"require('fs').rmSync('.next/dev/types',{recursive:true,force:true})\"",
    "build": "npm run db:generate && next build",
    "start": "next start -p 3000",
    "swarm": "tsx scripts/swarm.ts",
    "lint": "tsc --noEmit",
    "worker": "tsx worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "seed:sync": "tsx scripts/sync-seed-skills.ts",
    "hub:keygen": "tsx scripts/hub-keygen.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/sqlite/schema.prisma",
    "db:sqlite-schema": "tsx scripts/sqlite-schema.ts",
    "storage-keeper": "tsx scripts/storage-keeper.ts",
    "storage-migrate": "tsx scripts/storage-migrate.ts",
    "db:repair": "tsx scripts/db-repair.ts",
    "payments:reconcile": "tsx scripts/payments-reconcile.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "^13.0.3",
    "bolt-vault": "file:vendor/bolt-vault",
    "dockerode": "5.0.1",
    "dotenv": "^17.4.2",
    "katex": "0.16.22",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg": "^8.16.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tar": "7.5.22",
    "viem": "2.57.5",
    "yaml": "2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^3.3.44",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
