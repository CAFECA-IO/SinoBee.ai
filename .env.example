# SinoBee.ai — bootstrap settings only.
# Everything else (Oen payments, model API keys, CAFECA, pricing, retention, storage, Boltchain, runner, company
# details) is configured in /admin → Settings and stored in the database; secrets are encrypted there.
# `npm run swarm` moves any of those variables still found in this file into the database for you.
# A variable exported in the shell or passed with `docker run -e` still wins and is shown as locked in /admin.
# Keys and passwords (skill signing key, Boltchain site wallet and master key) are generated automatically.

# ───── Database ─────
# PostgreSQL connection. Leave empty to use SQLite (file at SQLITE_PATH) — handy for development / small installs.
DATABASE_URL=
# DATABASE_URL=postgresql://sinobee:sinobee@localhost:5432/sinobee
SQLITE_PATH=./data/sinobee.db

# Encryption key for secrets stored in the database. Leave empty: a random key is created in data/secrets.key
# (back that file up). Set it (64 hex characters) only to keep the key in a secret manager instead.
SECRETS_KEY=

# ───── Site ─────
# Exact public origin users sign in to (scheme + host + port). Must match what CAFECA signs.
PUBLIC_ORIGIN=http://localhost:3000
# Site owner (CAFECA account address): its first sign-in makes it the super admin.
# Leave empty to get a one-time claim code in the server log at startup instead (enter it at /admin/claim).
OWNER_ACCOUNT=
# development only: shows a "developer sign-in" button (ignored when NODE_ENV=production)
DEV_LOGIN=0

# ───── npm run swarm ─────
# SWARM_PORT=10023
# Local Boltchain node container: BOLT_NODE_RPC_PORT=8545, BOLT_NODE_KEEP=1 (leave it running), BOLTCHAIN_REF
# Written by `npm run swarm` when it starts its containers (point them at another host to use that server instead):
# 線上使用: the agent gateway's public origin and port (npm run agent-gateway), idle hours before a user's container stops
# AGENT_ORIGIN=http://localhost:10025
# AGENT_PORT=10025
# AGENT_IDLE_HOURS=2
# OLLAMA_URL=http://127.0.0.1:11434
# COMFYUI_URL=http://127.0.0.1:8188
# Swarm containers: SWARM_KEEP=1 (leave them running), SINOBEE_POSTGRES_PORT=15432, SINOBEE_OLLAMA_PORT=11434,
# SINOBEE_H3_PORT=8188, COMFYUI_REF, HF_TOKEN, H3_FILES
