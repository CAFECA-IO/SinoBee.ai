# ───── Core ─────
# PostgreSQL connection. Leave empty to use SQLite (file at SQLITE_PATH) — handy for development / small installs.
DATABASE_URL=
# DATABASE_URL=postgresql://sinobee:sinobee@localhost:5432/sinobee
SQLITE_PATH=./data/sinobee.db
# Exact public origin users sign in to (scheme + host + port). Must match what CAFECA signs.
PUBLIC_ORIGIN=http://localhost:3000

# ───── Sign in with CAFECA ─────
CAFECA_WALLET=https://cafeca.io
# optional: your own RPC for chain 8018 (default: the RPC in cafeca.io/.well-known/cafeca-configuration)
CAFECA_RPC_URL=
# Site owner (CAFECA account address). Its first sign-in makes it the super admin, who grants/revokes admins in /admin.
# Leave empty to get a one-time claim code in the server log at startup instead (enter it at /admin/claim).
OWNER_ACCOUNT=
# optional: comma separated accounts that start as admin on their first sign-in (never overrides later role changes)
ADMIN_ACCOUNTS=
# development only: shows a "developer sign-in" button (ignored when NODE_ENV=production)
DEV_LOGIN=0

# ───── Notifications through CAFECA ─────
# Webhook that delivers notifications to the user's CAFECA account. POST JSON {to, site, type, title, body, url, data}
CAFECA_NOTIFY_URL=
CAFECA_NOTIFY_TOKEN=

# ───── Payments: Oen (TWD) — https://developer.oen.tw ─────
# oen = real checkout; mock = local fake checkout page (development only, refused in production)
PAYMENT_MODE=oen
# testing → payment-api.testing.oen.tw, production → payment-api.oen.tw (production needs the server IP on Oen's allowlist)
OEN_ENV=testing
# your Oen domain, e.g. "sinobee" for https://sinobee.oen.tw
OEN_MERCHANT_ID=
# OEN_API_TOKEN: do NOT write it in this file. Pass it when starting, e.g.
#   docker run -e OEN_API_TOKEN=… …      or      OEN_API_TOKEN=… npm run swarm
# extra payment methods besides card (comma separated): cvs,atm,linePay
OEN_PAYMENT_METHODS=
# Webhook URL to set in the Oen CRM (總設定 → 開發者 → 應援金流設定 → 交易資料回傳網址位置):
#   ${PUBLIC_ORIGIN}/api/payments/oen/webhook
MIN_TASK_BUDGET_TWD=30
MIN_TOPUP_TWD=10

# ───── Pricing ─────
# Model tokens are billed at the published price (vendor USD × base FX × buffer), set in /admin → Model prices.
# VM and storage: AWS USD × base FX × PRICE_MARKUP
PRICE_MARKUP=1.5
# on-demand price of one task slot (default: m7i.xlarge, ap-northeast-1 reference — verify with current AWS pricing)
AWS_VM_HOURLY_USD=0.2604
AWS_S3_GB_MONTH_USD=0.025
AWS_S3_PUT_PER_1K_USD=0.0047
AWS_S3_GET_PER_1K_USD=0.00037

# ───── Retention ─────
RETENTION_FREE_DAYS=7
RETENTION_SUBSCRIBER_DAYS=90
# plans are edited in /admin → Plans; results/containers stay this long after the last period
SUBSCRIPTION_GRACE_DAYS=30
# 1 = delete expired results and idle containers; 0 (default) = only mark them expired
RETENTION_DELETE=0

# ───── Model relay for subscribers (/api/v1/llm/*) ─────
# Platform API keys: do NOT write them here. Pass them when starting, e.g.
#   docker run -e ANTHROPIC_API_KEY=… -e OPENAI_API_KEY=… -e GEMINI_API_KEY=… -e DEEPSEEK_API_KEY=… …
# (models without a key are listed as unavailable)
LLM_RPM=60
LLM_MAX_OUTPUT_TOKENS=32000
LLM_DEFAULT_OUTPUT_TOKENS=8192
LLM_DEFAULT_AVG_OUTPUT=800
LLM_TOPUP_TOKENS=256
LLM_HOLD_TIMEOUT_S=600
# daily spend cap per provider at published prices (0 = off), e.g. LLM_DAILY_LIMIT_TWD_ANTHROPIC=20000
LLM_DAILY_LIMIT_TWD=0

# ───── Legal (shown on /terms, /privacy, /refunds) ─────
LEGAL_ENTITY=CAFECA
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_EMAIL=contact@cafeca.com.tw
LEGAL_EFFECTIVE=2026-10-16

# ───── Storage (skill bundles + task results) ─────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
# for STORAGE_DRIVER=s3 (uses the standard AWS credential chain)
S3_BUCKET=
AWS_REGION=ap-northeast-1

# ───── Boltchain storage + notarization ─────
# When all three of BOLT_RPC_URL, BOLT_WALLET_KEY and BOLT_MASTER_KEY are set, every stored object
# (skill bundles, task results, tool manifests, vault packs, shares) is sealed with bolt-vault and kept
# in a SwarmStorage deal paid by the site wallet; the local/S3 storage above becomes a mirror.
# Run your own node with --rpc-storage (public RPCs have block hosting off).
BOLT_RPC_URL=
BOLT_CHAIN_ID=8018
# site wallet (0x + 64 hex) — pays deals and certificates in BOLT; pass it as a secret, never commit it
BOLT_WALLET_KEY=
# 32 bytes (64 hex or base64) — encrypts each object's vault key; losing it makes stored objects unreadable
BOLT_MASTER_KEY=
# Certificates contract (ADR 0016) for notarizing tool/share hashes; empty = no notarization
BOLT_CERTIFICATES=
BOLT_EXPLORER_URL=https://boltchain.cafeca.io
BOLT_REPLICAS=3
# epochs per deal and per renewal (testnet: 600 blocks ≈ 1–2 h); renew when fewer than this remain
BOLT_DEAL_EPOCHS=720
BOLT_RENEW_BELOW_EPOCHS=48
# highest accepted price in wei per GiB per epoch (empty = take the market price)
BOLT_MAX_PRICE_WEI=
# seconds per epoch (turns keep-until dates into epochs) and the low-balance alert threshold (wei)
BOLT_EPOCH_SECONDS=3600
BOLT_LOW_BALANCE_WEI=10000000000000000000
# 0 = drop the local/S3 copy once an object is on Boltchain (reads then come from the chain)
BOLT_MIRROR=1
# 0 = this worker does not run the storage keeper (run it on one or more workers)
STORAGE_KEEPER=1

# ───── Skill Hub signing (npm run hub:keygen) ─────
HUB_SIGNING_KEY=

# ───── Task worker ─────
# docker = real SinoBee containers (needs /var/run/docker.sock), mock = simulated runs
RUNNER_MODE=docker
SINOBEE_IMAGE=sinobee:latest
RUNNER_CONCURRENCY=2
RUNNER_CPUS=2
RUNNER_MEMORY_MB=4096
RUNNER_MAX_TASK_HOURS=12
RUNNER_POLL_SECONDS=10
# docker network for user containers (restrict egress there if needed)
RUNNER_NETWORK=
# env vars copied from the worker into user containers (model/search API keys)
RUNNER_PASS_ENV=OPENAI_API_KEY,ANTHROPIC_API_KEY,GEMINI_API_KEY,DEEPSEEK_API_KEY,OPENROUTER_API_KEY,BRAVE_API_KEY,TAVILY_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
