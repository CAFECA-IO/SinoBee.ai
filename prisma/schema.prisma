// SinoBee.ai data model
// Money is stored in TWDC (CAFECA stablecoin, 6 decimals) as Decimal(20,6).
// Raw provider costs (USD) are kept separately so the 1.5x markup is auditable.
//
// This is the PostgreSQL schema (used when DATABASE_URL is set).
// prisma/sqlite/schema.prisma is GENERATED from it (npm run db:sqlite-schema) for the SQLite fallback;
// keep the model portable: no scalar lists, no provider-specific features beyond @db.* (stripped for SQLite).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Accounts ─────────────────────────

model User {
  id                String   @id @default(cuid())
  /// CAFECA identity contract address (lowercase) — the stable user id
  account           String   @unique
  handle            String?
  /// Skill Hub publisher id (e.g. "cafeca"), [a-z0-9-]{2,39}
  publisher         String?  @unique
  displayName       String?
  kycLevel          Int?
  publisherVerified Boolean  @default(false)
  isAdmin           Boolean  @default(false)
  createdAt         DateTime @default(now())
  lastLoginAt       DateTime @default(now())

  sessions         Session[]
  apiTokens        ApiToken[]
  skills           Skill[]
  ratings          SkillRating[]
  comments         Comment[]
  tasks            Task[]
  taskVotes        TaskVote[]
  payments         Payment[]
  subscriptions    Subscription[]
  notifications    Notification[]
  container        UserContainer?
  evaluations      EvaluationReport[]
  reviewedVersions SkillVersion[]      @relation("reviewer")
  devices          Device[]
  deviceAuths      DeviceAuth[]
  tools            Tool[]
  vaultKey         VaultKey?
  vaultPacks       VaultPack[]
  shares           ConversationShare[]
  reports          Report[]
  reviewedTools ToolVersion[] @relation("toolReviewer")
  toolRatings   ToolRating[]
}

model Session {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CAFECA signing channel id granted at sign-in (keys live in the browser)
  channelId        String?
  channelExpiresAt DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@index([userId])
}

/// One-time sign-in nonces (bound to a browser via the `sb_bind` cookie)
model AuthNonce {
  nonce     String   @id
  bind      String
  expiresAt DateTime
  used      Boolean  @default(false)
  /// post-mode (QR) result waiting to be picked up by the polling browser
  userId    String?
  response  Json?
  error     String?
  createdAt DateTime @default(now())
}

/// Bearer tokens for `sinobee skills publish` (Hub API v1)
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  tokenHash  String    @unique
  /// space-separated scopes: skills:publish tools:write vault:rw shares:write
  scopes     String    @default("skills:publish")
  /// set for tokens issued to a SinoBee install through the device flow
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

/// A SinoBee install signed in with `sinobee login` (OAuth 2.0 device authorization grant, RFC 8628)
model Device {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String?
  /// X25519 public key of this install; the vault key is wrapped to it so the user need not retype the passphrase
  publicKey  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  tokens     ApiToken[]
  vaultKey   VaultDeviceKey?

  @@index([userId])
}

enum DeviceAuthStatus {
  PENDING
  APPROVED
  DENIED
  CONSUMED
}

model DeviceAuth {
  id             String           @id @default(cuid())
  deviceCodeHash String           @unique
  /// 8 chars from an unambiguous alphabet, shown as XXXX-XXXX
  userCode       String           @unique
  scopes         String
  deviceName     String
  platform       String?
  /// X25519 public key the device will use for its vault key
  publicKey      String?
  ip             String?
  status         DeviceAuthStatus @default(PENDING)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  interval       Int              @default(5)
  lastPollAt     DateTime?
  expiresAt      DateTime
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
}

// ───────────────────────── Skill Hub ─────────────────────────

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVOKED
}

enum ScanVerdict {
  CLEAN
  WARNING
  DANGEROUS
}

model Skill {
  id            String   @id @default(cuid())
  publisherId   String
  publisher     User     @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  name          String
  description   String
  license       String?
  downloads     Int      @default(0)
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  latestVersion String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions SkillVersion[]
  ratings  SkillRating[]
  tags     SkillTag[]

  @@unique([publisherId, name])
  @@index([downloads])
}

model SkillVersion {
  id           String       @id @default(cuid())
  skillId      String
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version      String
  /// "sha256:<hex>" — SinoBee content hash (sorted path \0 bytes \0 ...)
  contentHash  String
  /// storage key of the .tar.gz bundle
  bundleKey    String
  bundleSize   Int
  manifest     Json
  skillMd      String
  files        Json
  /// base64 ed25519 signature of contentHash (set when approved)
  signature    String?
  /// Boltchain certificate code: the bundle and SKILL.md hashes, notarized at publish
  anchorCode   String?
  status       ReviewStatus @default(PENDING_REVIEW)
  scanVerdict  ScanVerdict  @default(CLEAN)
  scanFindings Json         @default("[]")
  reviewNote   String?
  reviewerId   String?
  reviewer     User?        @relation("reviewer", fields: [reviewerId], references: [id])
  reviewedAt   DateTime?
  publishedAt  DateTime     @default(now())
  downloads    Int          @default(0)

  tasks       Task[]
  evaluations EvaluationReport[]

  @@unique([skillId, version])
  @@index([contentHash])
}

model SkillTag {
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tag     String

  @@id([skillId, tag])
  @@index([tag])
}

model SkillRating {
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars     Int
  updatedAt DateTime @updatedAt

  @@id([skillId, userId])
}

model Revocation {
  contentHash String   @id
  reason      String
  createdAt   DateTime @default(now())
}

enum CommentTarget {
  SKILL
  TASK
  EVALUATION
}

model Comment {
  id         String        @id @default(cuid())
  targetType CommentTarget
  targetId   String
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?      @relation("thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("thread")
  body       String
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())

  @@index([targetType, targetId, createdAt])
}

// ───────────────────────── Commissioned tasks ─────────────────────────

enum TaskKind {
  TASK
  EVALUATION
}

enum TaskStatus {
  AWAITING_PAYMENT
  QUEUED
  RUNNING
  NEEDS_FUNDING
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           TaskKind      @default(TASK)
  title          String
  prompt         String
  model          String
  skillVersionId String?
  skillVersion   SkillVersion? @relation(fields: [skillVersionId], references: [id])
  isPublic       Boolean       @default(false)
  status         TaskStatus    @default(AWAITING_PAYMENT)

  /// total TWDC funded (initial + top-ups)
  budget       Decimal @default(0) @db.Decimal(20, 6)
  /// TWDC charged so far (= 1.5 x raw costs converted at usdTwdRate)
  charged      Decimal @default(0) @db.Decimal(20, 6)
  usdTwdRate   Decimal @default(32) @db.Decimal(12, 6)
  /// raw provider costs in USD
  tokenCostUsd Decimal @default(0) @db.Decimal(20, 8)
  vmCostUsd    Decimal @default(0) @db.Decimal(20, 8)
  s3CostUsd    Decimal @default(0) @db.Decimal(20, 8)
  inputTokens  BigInt  @default(0)
  outputTokens BigInt  @default(0)
  vmSeconds    Int     @default(0)

  /// evaluation fields (kind = EVALUATION)
  evalMethod   String?
  evalCriteria String?

  summary            String?
  error              String?
  containerName      String?
  workerId           String?
  heartbeatAt        DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  /// set when budget is exhausted; auto-closes after the retention window
  fundingRequestedAt DateTime?
  /// results download deadline (7 days for non-subscribers)
  resultsExpireAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  artifacts Artifact[]
  events    TaskEvent[]
  votes     TaskVote[]
  payments  Payment[]
  report    EvaluationReport?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([isPublic, createdAt])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model Artifact {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  key       String
  filename  String
  sizeBytes BigInt
  sha256    String
  partial   Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  deletedAt DateTime?
}

model TaskVote {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// +1 good, -1 bad
  value     Int
  updatedAt DateTime @updatedAt

  @@id([taskId, userId])
}

/// Per-user isolated docker container (+ volume)
model UserContainer {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  containerName String    @unique
  volumeName    String
  status        String    @default("created")
  lastActiveAt  DateTime  @default(now())
  /// removed by the cleanup job after this time (7 days after last task for non-subscribers)
  expiresAt     DateTime?
}

// ───────────────────────── Evaluations ─────────────────────────

model EvaluationReport {
  id             String        @id @default(cuid())
  taskId         String        @unique
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  skillVersionId String?
  skillVersion   SkillVersion? @relation(fields: [skillVersionId], references: [id])
  model          String
  method         String
  methodDetail   String
  /// step-by-step transcript of the evaluation
  process        String
  /// { score: 0-100, metrics: {name: number}, verdict, summary }
  result         Json
  score          Float?
  evaluatedAt    DateTime      @default(now())

  @@index([model])
  @@index([skillVersionId])
}

// ───────────────────────── Payments & subscriptions ─────────────────────────

enum PaymentPurpose {
  TASK_BUDGET
  TASK_TOPUP
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Payment {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  purpose     PaymentPurpose
  amount      Decimal        @db.Decimal(20, 6)
  /// amount in token base units (string, to avoid precision loss)
  amountBase  String
  token       String
  recipient   String
  status      PaymentStatus  @default(PENDING)
  txHash      String?        @unique
  error       String?
  meta        Json?
  createdAt   DateTime       @default(now())
  confirmedAt DateTime?
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  startsAt  DateTime
  endsAt    DateTime
  paymentId String   @unique
  createdAt DateTime @default(now())

  @@index([userId, endsAt])
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  title             String
  body              String
  link              String?
  data              Json?
  readAt            DateTime?
  /// delivery to CAFECA (null = not delivered / not configured)
  cafecaDeliveredAt DateTime?
  cafecaError       String?
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────── Tools (database browser registrations) ─────────────────────────

enum ToolVisibility {
  PRIVATE
  PUBLIC
}

/// A tool registered from SinoBee (e.g. a database browser). The manifest never contains secrets.
model Tool {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  kind          String         @default("database")
  description   String         @default("")
  visibility    ToolVisibility @default(PRIVATE)
  latestVersion String?
  installs      Int            @default(0)
  ratingAvg     Float          @default(0)
  ratingCount   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  versions      ToolVersion[]
  ratings       ToolRating[]

  @@unique([ownerId, name])
  @@index([visibility, updatedAt])
}

model ToolVersion {
  id           String       @id @default(cuid())
  toolId       String
  tool         Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  version      String
  /// "sha256:<hex>" of the canonical TOOL.json
  contentHash  String
  manifest     Json
  /// storage object holding TOOL.json (Boltchain-backed)
  objectKey    String?
  /// published for everyone (reviewed) vs. for the owner only — a tool that goes public never exposes its private versions
  public       Boolean      @default(false)
  /// public versions go through review; private ones are APPROVED immediately
  status       ReviewStatus @default(APPROVED)
  scanFindings Json         @default("[]")
  reviewNote   String?
  reviewerId   String?
  reviewer     User?        @relation("toolReviewer", fields: [reviewerId], references: [id])
  reviewedAt   DateTime?
  anchorCode   String?
  publishedAt  DateTime     @default(now())

  @@unique([toolId, version])
}

model ToolRating {
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars     Int
  updatedAt DateTime @updatedAt

  @@id([toolId, userId])
}

// ───────────────────────── End-to-end encrypted vault ─────────────────────────

/// Wrapped vault key: the user's X25519 private key encrypted with a key derived (scrypt) from their passphrase.
/// The server never sees the passphrase or the plaintext key.
model VaultKey {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey String
  /// base64 { v, kdf:{n,r,p,salt}, iv, ct } (AES-256-GCM)
  wrapped   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An encrypted blob (e.g. private tool connection settings + secrets) only the owner can open
/// The vault private key sealed to one device's X25519 key (deleted when the device is signed out)
model VaultDeviceKey {
  deviceId  String   @id
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId    String
  /// sealed envelope {v, epk, iv, ct}
  wrapped   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model VaultPack {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// storage object key of the ciphertext
  objectKey String
  size      Int
  sha256    String
  /// increments on every write; clients send the version they read (optimistic concurrency)
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// ───────────────────────── Conversation sharing ─────────────────────────

enum ShareVisibility {
  /// anyone with the link (unlisted)
  LINK
  /// signed-in users; optionally only the CAFECA accounts in ShareAccess
  LOGIN
  /// listed publicly
  PUBLIC
}

model ConversationShare {
  id          String          @id
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  visibility  ShareVisibility @default(LINK)
  /// LOGIN only: restrict to ShareAccess accounts
  restricted  Boolean         @default(false)
  /// storage object key of the share JSON (messages, already redacted by the client)
  objectKey   String
  contentHash String
  messages    Int
  model       String?
  views       Int             @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  anchorCode  String?
  createdAt   DateTime        @default(now())

  access ShareAccess[]
  files  ShareFile[]

  @@index([ownerId, createdAt])
  @@index([visibility, createdAt])
}

model ShareAccess {
  shareId String
  share   ConversationShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  /// CAFECA identity contract address (lowercase)
  account String

  @@id([shareId, account])
  @@index([account])
}

model ShareFile {
  id        String            @id @default(cuid())
  shareId   String
  share     ConversationShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  name      String
  objectKey String
  size      Int
  sha256    String
  mime      String
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([targetType, targetId])
}

// ───────────────────────── Storage on Boltchain ─────────────────────────

enum StorageStatus {
  /// stored in the mirror only, waiting for the Boltchain worker
  PENDING
  /// sealed with bolt-vault, blocks hosted, deal created
  STORED
  /// deal ended or could not be created; mirror still serves it
  FAILED
  /// deleted: object key destroyed (crypto-shred) and deal cancelled
  DELETED
}

/// One logical object (skill bundle, task artifact, tool manifest, vault pack, share).
/// Bytes are sealed with bolt-vault for a per-object X25519 recipient whose private key is
/// encrypted with the site master key; destroying `recipientKey` makes the on-chain copy unreadable.
model StorageObject {
  key          String        @id
  kind         String
  size         BigInt
  sha256       String
  keccak       String
  contentType  String        @default("application/octet-stream")
  status       StorageStatus @default(PENDING)
  /// bolt-vault envelope CID (raw CIDv1) and deal index root (dag-cbor CIDv1)
  envelopeCid  String?
  dealRoot     String?
  dealId       BigInt?
  /// none | active | cancelled (ends after the current epoch) | closed (refund settled)
  dealState    String        @default("none")
  blocks       Int?
  dealSize     BigInt?
  replicas     Int?
  endEpoch     BigInt?
  /// BOLT paid by the site wallet (wei, decimal string)
  paidWei      String?
  txHash       String?
  /// AES-256-GCM(site master key, X25519 private key), base64
  recipientKey String?
  /// keep the mirror copy (local/S3) for fast reads
  mirrored     Boolean       @default(true)
  /// copies wanted (policy by kind; shares 2, others 3)
  wantReplicas Int?
  /// stop renewing after this time (e.g. a share's expiry); the deal is sized to end then
  keepUntil    DateTime?
  /// deleted, but the key is kept and the deal runs until then (public tools: 90 days after takedown)
  deleteAfter  DateTime?
  lastAuditAt  DateTime?
  error        String?
  attempts     Int           @default(0)
  nextTryAt    DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([status, nextTryAt])
  @@index([dealState, endEpoch])
}

/// Content hashes notarized with the Boltchain Certificates contract (third-party verifiable)
model Anchor {
  id         String    @id @default(cuid())
  /// what was anchored: tool-version | share | skill-version | artifact
  targetType String
  targetId   String
  /// 16-char Crockford base32 certificate code (null until issued)
  code       String?   @unique
  salt       String
  /// [{name, sha256, keccak, size}]
  files      Json
  root       String?
  txHash     String?
  status     String    @default("pending")
  error      String?
  attempts   Int       @default(0)
  nextTryAt  DateTime  @default(now())
  createdAt  DateTime  @default(now())
  issuedAt   DateTime?

  @@unique([targetType, targetId])
  @@index([status, nextTryAt])
}
