// SinoBee.ai data model
// Money is stored in TWDC (CAFECA stablecoin, 6 decimals) as Decimal(20,6).
// Raw provider costs (USD) are kept separately so the 1.5x markup is auditable.
//
// This is the PostgreSQL schema (used when DATABASE_URL is set).
// prisma/sqlite/schema.prisma is GENERATED from it (npm run db:sqlite-schema) for the SQLite fallback;
// keep the model portable: no scalar lists, no provider-specific features beyond @db.* (stripped for SQLite).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Accounts ─────────────────────────

model User {
  id                String   @id @default(cuid())
  /// CAFECA identity contract address (lowercase) — the stable user id
  account           String   @unique
  handle            String?
  /// Skill Hub publisher id (e.g. "cafeca"), [a-z0-9-]{2,39}
  publisher         String?  @unique
  displayName       String?
  kycLevel          Int?
  publisherVerified Boolean  @default(false)
  /// kept in sync with role (true for ADMIN and SUPERADMIN); change roles only through src/lib/roles.ts
  isAdmin           Boolean  @default(false)
  role              UserRole @default(USER)
  /// last buyer details used at checkout {name, email, invoice}, to prefill the next one
  billing           Json?
  createdAt         DateTime @default(now())
  lastLoginAt       DateTime @default(now())

  sessions          Session[]
  apiTokens         ApiToken[]
  skills            Skill[]
  ratings           SkillRating[]
  comments          Comment[]
  tasks             Task[]
  payments          Payment[]
  subscriptions     Subscription[]
  notifications     Notification[]
  evaluations       EvaluationReport[]
  evaluationStudies EvaluationStudy[]
  benchEvals        BenchEval[]
  benchSuites       BenchSuite[]
  reviewedVersions  SkillVersion[]      @relation("reviewer")
  devices           Device[]
  deviceAuths       DeviceAuth[]
  tools             Tool[]
  vaultKey          VaultKey?
  vaultPacks        VaultPack[]
  shares            ConversationShare[]
  reports           Report[]
  reviewedTools     ToolVersion[]       @relation("toolReviewer")
  toolRatings       ToolRating[]
  adminActions      AdminAudit[]        @relation("auditActor")
  modelPrices       ModelPrice[]
  usage             UsageLedger[]
  pledges           Pledge[]
  savedCards        SavedCard[]
  points            PointLedger[]
  acceptanceVotes   AcceptanceVote[]
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

/// Key/value site state: owner bootstrap (claim code), pricing defaults (FX rate, buffer)
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Append-only log of privileged actions (roles, prices, plans, reviews, takedowns)
model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("auditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model Session {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CAFECA signing channel id granted at sign-in (keys live in the browser)
  channelId        String?
  channelExpiresAt DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@index([userId])
}

/// One-time sign-in nonces (bound to a browser via the `sb_bind` cookie)
model AuthNonce {
  nonce     String   @id
  bind      String
  expiresAt DateTime
  used      Boolean  @default(false)
  /// post-mode (QR) result waiting to be picked up by the polling browser
  userId    String?
  response  Json?
  error     String?
  createdAt DateTime @default(now())
}

/// Bearer tokens for `sinobee skills publish` (Hub API v1)
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  tokenHash  String    @unique
  /// space-separated scopes: skills:publish tools:write vault:rw shares:write
  scopes     String    @default("skills:publish")
  /// set for tokens issued to a SinoBee install through the device flow
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// "pat" (personal / legacy device token), "access" (15 minutes, signed requests), "refresh" (device-bound)
  kind       String    @default("pat")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

/// A SinoBee install signed in with `sinobee login` (OAuth 2.0 device authorization grant, RFC 8628)
model Device {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String?
  /// X25519 public key of this install; the vault key is wrapped to it so the user need not retype the passphrase
  publicKey  String?
  /// Ed25519 public key (raw 32 bytes, base64): every request with this device's tokens must be signed with it
  signingKey String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  tokens   ApiToken[]
  vaultKey VaultDeviceKey?

  @@index([userId])
}

enum DeviceAuthStatus {
  PENDING
  APPROVED
  DENIED
  CONSUMED
}

model DeviceAuth {
  id             String           @id @default(cuid())
  deviceCodeHash String           @unique
  /// 8 chars from an unambiguous alphabet, shown as XXXX-XXXX
  userCode       String           @unique
  scopes         String
  deviceName     String
  platform       String?
  /// X25519 public key the device will use for its vault key
  publicKey      String?
  /// Ed25519 request-signing key of the device
  signingKey     String?
  ip             String?
  status         DeviceAuthStatus @default(PENDING)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  interval       Int              @default(5)
  lastPollAt     DateTime?
  expiresAt      DateTime
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
}

// ───────────────────────── Skill Hub ─────────────────────────

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVOKED
}

enum ScanVerdict {
  CLEAN
  WARNING
  DANGEROUS
}

model Skill {
  id            String   @id @default(cuid())
  publisherId   String
  publisher     User     @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  name          String
  description   String
  license       String?
  downloads     Int      @default(0)
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  latestVersion String?
  /// "skill" | "evaluation" (SKILL.md metadata sinobee-type) - an evaluation skill writes evaluation suites
  kind          String   @default("skill")
  /// evaluation skills: the skills it is for, comma-separated names or globs ("*" = any)
  targets       String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions SkillVersion[]
  ratings  SkillRating[]
  tags     SkillTag[]

  @@unique([publisherId, name])
  @@index([downloads])
}

model SkillVersion {
  id             String       @id @default(cuid())
  skillId        String
  skill          Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version        String
  /// "sha256:<hex>" — SinoBee content hash (sorted path \0 bytes \0 ...)
  contentHash    String
  /// storage key of the .tar.gz bundle
  bundleKey      String
  bundleSize     Int
  manifest       Json
  skillMd        String
  files          Json
  /// base64 ed25519 signature of contentHash (set when approved)
  signature      String?
  /// Boltchain certificate code: the bundle and SKILL.md hashes, notarized at publish
  anchorCode     String?
  status         ReviewStatus @default(PENDING_REVIEW)
  scanVerdict    ScanVerdict  @default(CLEAN)
  scanFindings   Json         @default("[]")
  reviewNote     String?
  reviewerId     String?
  reviewer       User?        @relation("reviewer", fields: [reviewerId], references: [id])
  reviewedAt     DateTime?
  publishedAt    DateTime     @default(now())
  downloads      Int          @default(0)
  /// evaluation skills: the 4 security checks {static: {ok, issues}, behavior: {ok, note, by, at}, suite: {ok, checked, problems}}
  /// (the 4th, human review, is status APPROVED)
  securityReport Json?

  tasks           Task[]
  evaluations     EvaluationReport[]
  benchSuites     BenchSuite[]       @relation("suiteSkill")
  evaluatorSuites BenchSuite[]       @relation("suiteEvaluator")
  benchEvals      BenchEval[]

  @@unique([skillId, version])
  @@index([contentHash])
}

model SkillTag {
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tag     String

  @@id([skillId, tag])
  @@index([tag])
}

model SkillRating {
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars     Int
  updatedAt DateTime @updatedAt

  @@id([skillId, userId])
}

model Revocation {
  contentHash String   @id
  reason      String
  createdAt   DateTime @default(now())
}

enum CommentTarget {
  SKILL
  TASK
  EVALUATION
}

model Comment {
  id         String        @id @default(cuid())
  targetType CommentTarget
  targetId   String
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?      @relation("thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("thread")
  body       String
  /// "comment" (discussion), "reference" (a backer's reference info, read by the agent), "status" (agent report)
  kind       String        @default("comment")
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())

  @@index([targetType, targetId, createdAt])
}

// ───────────────────────── Tasks (crowdfunded) ─────────────────────────

enum TaskKind {
  TASK
  /// a model / skill evaluation: the result is published as an EvaluationReport
  EVALUATION
}

enum TaskStatus {
  /// crowdfunding proposal being written (spec dialogue, reference files)
  DRAFT
  /// submitted for funding: queued for the AI screening against the checklist
  SCREENING
  /// crowdfunding open: pledges are collected (cards are bound, not charged)
  FUNDING
  /// goal reached: card pledges are being charged (retries during the grace period)
  CHARGING
  /// crowdfunding ended without reaching the goal (nothing charged)
  UNFUNDED
  /// crowdfunded run finished: backers vote on the acceptance criteria
  IN_REVIEW
  /// acceptance rejected and no rework possible: waiting for the platform's decision
  DISPUTED
  QUEUED
  RUNNING
  NEEDS_FUNDING
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           TaskKind      @default(TASK)
  title          String
  prompt         String
  model          String
  skillVersionId String?
  skillVersion   SkillVersion? @relation(fields: [skillVersionId], references: [id])
  isPublic       Boolean       @default(false)
  status         TaskStatus    @default(DRAFT)

  /// total TWD funded (collected pledges and top-up rounds, minus refunds)
  budget           Decimal  @default(0) @db.Decimal(20, 6)
  /// TWD charged so far: tokens at the published model price + (VM + storage) × markup, see src/lib/pricing.ts
  charged          Decimal  @default(0) @db.Decimal(20, 6)
  /// USD→TWD rate snapshotted when the task was created (the site's base FX rate)
  usdTwdRate       Decimal  @default(32) @db.Decimal(12, 6)
  /// published-price buffer snapshotted at creation (e.g. 1.08); null = legacy task billed with the markup on tokens
  priceBuffer      Decimal? @db.Decimal(10, 4)
  /// vendor USD per 1M tokens {input, cacheRead, cacheWrite, output} snapshotted at creation
  modelPriceUsd    Json?
  cacheReadTokens  BigInt   @default(0)
  cacheWriteTokens BigInt   @default(0)
  /// raw provider costs in USD
  tokenCostUsd     Decimal  @default(0) @db.Decimal(20, 8)
  vmCostUsd        Decimal  @default(0) @db.Decimal(20, 8)
  s3CostUsd        Decimal  @default(0) @db.Decimal(20, 8)
  inputTokens      BigInt   @default(0)
  outputTokens     BigInt   @default(0)
  vmSeconds        Int      @default(0)

  /// evaluation fields (kind = EVALUATION)
  evalMethod   String?
  evalCriteria String?

  summary            String?
  error              String?
  containerName      String?
  workerId           String?
  heartbeatAt        DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  /// set when budget is exhausted; auto-closes after the retention window
  fundingRequestedAt DateTime?
  /// results download deadline (7 days for non-subscribers)
  resultsExpireAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  artifacts  Artifact[]
  events     TaskEvent[]
  payments   Payment[]
  report     EvaluationReport?
  pledges    Pledge[]
  inputFiles TaskInputFile[]

  // ── crowdfunding (crowdfund = true) ──
  crowdfund           Boolean          @default(true)
  /// goal in whole TWD (a multiple of the share price)
  goalTwd             Int?
  /// 7, 30 or 90 (null when paid in full by the proposer)
  durationDays        Int?
  deadlineAt          DateTime?
  /// start charging as soon as the goal is reached instead of at the deadline
  startEarly          Boolean          @default(false)
  /// paid in full by the proposer (no crowdfunding period; charged when the screening passes)
  selfFunded          Boolean          @default(false)
  /// the saved card the proposer chose to pay with (self-funded)
  selfCardId          String?
  /// platform service fee rate snapshotted when funding opens (0 for 7 days)
  serviceFeeRate      Decimal?         @db.Decimal(6, 4)
  serviceFeeTwd       Int              @default(0)
  /// proposal: {summary, scope, outOfScope, deliverables[], method[], acceptance[], estimate {p50Twd, p90Twd, basis}, stretch[], risks[]}
  spec                Json?
  specVersion         Int              @default(0)
  /// spec dialogue [{role: "user" | "assistant", content, at}]
  specChat            Json?
  /// proposal fee credit (published-price TWD) and what the spec dialogue, storage and extra file space used
  proposalCreditTwd   Decimal          @default(0) @db.Decimal(20, 6)
  proposalUsedTwd     Decimal          @default(0) @db.Decimal(20, 6)
  /// unused proposal credit moved into the budget when funded (kept by the platform at settlement, never points)
  proposalToBudgetTwd Decimal          @default(0) @db.Decimal(20, 6)
  fundingStartedAt    DateTime?
  fundedAt            DateTime?
  /// end of the grace period for failed card charges
  chargeDeadlineAt    DateTime?
  /// leftover budget returned to backers (points / quota)
  settledAt           DateTime?
  /// a spec revision while funding: backers may withdraw until then, charging waits for it
  exitUntil           DateTime?
  /// research | data | writing | code | translation | media | other
  category            String?
  /// screening of the proposal before it opens: {decision, reasons, by: "ai" | "admin", at}
  screening           Json?
  /// set when an admin takes the campaign down after a report
  takenDownAt         DateTime?
  /// version of the crowdfunding terms (with the screening checklist) the proposer agreed to
  /// next AI screening attempt by the worker (null = not queued)
  screenAt            DateTime?
  termsVersion        Int?
  /// stretch goals unlocked by money collected beyond the goal (count, in spec order)
  stretchUnlocked     Int              @default(0)
  /// top-up round after the budget ran out: goal (whole TWD) and deadline; pledges wait until it is met
  topupGoalTwd        Int?
  topupDeadlineAt     DateTime?
  /// acceptance: the agent's self-check {criteria: [{criterion, passed, evidence}], summary}, review deadline, reworks done
  acceptance          Json?
  reviewDeadlineAt    DateTime?
  reworks             Int              @default(0)
  /// why the last review rejected the result (given to the agent for the rework)
  reworkNotes         String?
  acceptanceVotes     AcceptanceVote[]
  revisions           SpecRevision[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([isPublic, createdAt])
  @@index([crowdfund, status, deadlineAt])
  @@index([status, screenAt])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model Artifact {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  key       String
  filename  String
  sizeBytes BigInt
  sha256    String
  partial   Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  deletedAt DateTime?
}

// ───────────────────────── Evaluations ─────────────────────────

model EvaluationReport {
  id             String        @id @default(cuid())
  taskId         String        @unique
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  skillVersionId String?
  skillVersion   SkillVersion? @relation(fields: [skillVersionId], references: [id])
  model          String
  method         String
  methodDetail   String
  /// step-by-step transcript of the evaluation
  process        String
  /// { score: 0-100, metrics: {name: number}, verdict, summary }
  result         Json
  score          Float?
  evaluatedAt    DateTime      @default(now())

  @@index([model])
  @@index([skillVersionId])
}

/// A published evaluation that compares models: on one domain (kind "model") or using one skill (kind "skill").
/// Run in SinoBee (`sinobee eval run <suite> -m <model> --judge <model>`, one run per model) and published with
/// `sinobee eval publish`; every number on the page comes from those runs.
model EvaluationStudy {
  id            String    @id @default(cuid())
  publisherId   String
  publisher     User      @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  /// "model" | "skill"
  kind          String
  title         String
  domain        String    @default("")
  /// skill name (kind "skill")
  skill         String?
  summary       String    @default("")
  /// the report text (Markdown)
  body          String    @default("")
  suite         String
  judgeModel    String?
  clientVersion String?
  testedAt      DateTime
  testedUntil   DateTime?
  /// [{model, solo, totals, judge_usage, tasks: [{id, title, prompt, graders, trials: [...]}]}]
  runs          Json
  /// "model1,model2" for listings
  models        String    @default("")
  /// the model with the highest score
  bestModel     String?
  bestScore     Float?
  hidden        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([kind, createdAt])
}

// ───────────────────────── Payments & subscriptions ─────────────────────────

enum PaymentPurpose {
  /// crowdfunding proposal fee (credit for the spec dialogue, storage and extra file space)
  CROWD_PROPOSAL
  /// a backer's card pledges for one task, charged with the saved card token
  CROWD_PLEDGE
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  /// checkout page timed out without a payment
  EXPIRED
  /// fully refunded (partial refunds keep CONFIRMED with refundedTwd > 0)
  REFUNDED
}

enum PaymentProvider {
  /// legacy CAFECA TWDC transfers (history only)
  TWDC
  OEN
  /// development only (PAYMENT_MODE=mock)
  MOCK
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId            String?
  task              Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  purpose           PaymentPurpose
  amount            Decimal         @db.Decimal(20, 6)
  /// TWDC: amount in token base units. OEN/MOCK: the integer TWD amount as a string
  amountBase        String
  /// TWDC: token contract. OEN/MOCK: "TWD"
  token             String
  /// TWDC: treasury address. OEN: merchant id
  recipient         String
  provider          PaymentProvider @default(TWDC)
  /// made while the site was in test mode (Oen testing environment; excluded from revenue)
  sandbox           Boolean         @default(false)
  /// the saved card charged (every Oen payment is a card token charge)
  cardId            String?
  /// integer TWD charged through Oen
  amountTwd         Int?
  /// Oen internal transaction id (27 chars, used for GET /transactions/:id and in webhooks)
  oenId             String?         @unique
  /// Oen transaction number (P…, used for refunds)
  transactionHid    String?         @unique
  checkoutUrl       String?
  checkoutExpiresAt DateTime?
  paidAt            DateTime?
  /// subscription plan bought (Plan.id)
  planId            String?
  /// buyer name / email / invoice info sent to Oen for the e-invoice
  buyer             Json?
  refundedTwd       Int             @default(0)
  refundedAt        DateTime?
  refundReason      String?
  /// last Oen transaction status seen (initiated, charging, charged, …)
  providerStatus    String?
  status            PaymentStatus   @default(PENDING)
  txHash            String?         @unique
  pledges           Pledge[]
  error             String?
  meta              Json?
  createdAt         DateTime        @default(now())
  confirmedAt       DateTime?
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String
  startsAt    DateTime
  endsAt      DateTime
  paymentId   String    @unique
  /// Plan.id at purchase (plan holds the code)
  planId      String?
  /// results and container are kept until graceEndsAt (endsAt + 30 days)
  graceEndsAt DateTime?
  /// refunded periods are cancelled; later periods move up
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, endsAt])
}

/// Nonces of signed device requests seen in the last few minutes (replay protection)
model RequestNonce {
  deviceId  String
  nonce     String
  createdAt DateTime @default(now())

  @@id([deviceId, nonce])
  @@index([createdAt])
}

// ───────────────────────── Model relay (subscriptions) ─────────────────────────

enum UsageStatus {
  /// reserved while the request runs (counts toward the windows at heldTwd)
  HELD
  /// settled from the upstream usage report
  SETTLED
  /// settled from our own token count (no usage from upstream, client abort, quota stop)
  ESTIMATED
  /// never settled by the request; the sweeper settled it after 10 minutes at the larger of hold and count
  EXPIRED
  /// upstream failed before producing output: nothing charged
  REFUNDED
}

/**
 * One relayed model call. The 6 h / 168 h rolling windows sum heldTwd for HELD rows and settledTwd for the
 * rest, at the time the cost was incurred (settledAt, or createdAt while held).
 */
model UsageLedger {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// subscription period the call ran under
  subscriptionId   String?
  planId           String?
  deviceId         String?
  modelId          String
  endpoint         String
  stream           Boolean     @default(false)
  status           UsageStatus @default(HELD)
  heldTwd          Decimal     @default(0) @db.Decimal(20, 6)
  settledTwd       Decimal?    @db.Decimal(20, 6)
  /// published TWD per 1M tokens {input, cacheRead, cacheWrite, output} at hold time
  priceTwd         Json
  promptTokens     Int         @default(0)
  outputTokens     Int         @default(0)
  cacheReadTokens  Int         @default(0)
  cacheWriteTokens Int         @default(0)
  /// output tokens the hold covers (estimate + top-ups)
  heldOutput       Int         @default(0)
  /// output tokens counted by us while streaming
  countedOutput    Int         @default(0)
  error            String?
  createdAt        DateTime    @default(now())
  settledAt        DateTime?

  /// subscription | points: who paid. Points rows stay out of the 6 h / 168 h windows; each settled points row
  /// takes platform points 1:1 at the published TWD price (PointLedger reason "llm_usage")
  billing          String      @default("subscription")

  @@index([userId, status])
  @@index([userId, settledAt])
  @@index([userId, createdAt])
  @@index([userId, billing, status])
  @@index([status, createdAt])
}

/**
 * Average output length per user and model (last ~50 calls), used to size holds
 */
model UserModelStats {
  userId    String
  modelId   String
  avgOutput Float    @default(800)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, modelId])
}

// ───────────────────────── Prices & plans ─────────────────────────

/// Model price history. The row in force for a model is the latest with effectiveAt <= now.
/// Published price (TWD per 1M tokens) = vendor USD × fxRate × buffer; both are snapshotted per row.
model ModelPrice {
  id            String   @id @default(cuid())
  /// provider/model as SinoBee expects (SINOBEE_MODEL)
  modelId       String
  label         String
  vendor        String
  /// vendor list prices, USD per 1M tokens
  inputUsd      Decimal  @db.Decimal(20, 6)
  cacheReadUsd  Decimal  @db.Decimal(20, 6)
  cacheWriteUsd Decimal  @db.Decimal(20, 6)
  outputUsd     Decimal  @db.Decimal(20, 6)
  fxRate        Decimal  @db.Decimal(20, 6)
  buffer        Decimal  @db.Decimal(20, 6)
  /// offered to users (false = withdrawn from this date)
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  effectiveAt   DateTime
  createdAt     DateTime @default(now())
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([modelId, effectiveAt])
}

/// Subscription plans. Max cost V = fee ÷ multiplier; L168 = V ÷ 4.8; L6 = L168 ÷ 10 (TWD at published prices).
model Plan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  nameEn      String
  feeTwd      Decimal  @db.Decimal(20, 2)
  /// max usage ÷ fee (usage at published prices); margin = price buffer ÷ multiplier
  multiplier  Decimal  @db.Decimal(10, 4)
  maxCostTwd  Decimal  @db.Decimal(20, 2)
  l6Twd       Decimal  @db.Decimal(20, 2)
  l168Twd     Decimal  @db.Decimal(20, 2)
  concurrency Int      @default(2)
  days        Int      @default(30)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  title             String
  body              String
  link              String?
  data              Json?
  readAt            DateTime?
  /// delivery to CAFECA (null = not delivered / not configured)
  cafecaDeliveredAt DateTime?
  cafecaError       String?
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────── Tools (database browser registrations) ─────────────────────────

enum ToolVisibility {
  PRIVATE
  PUBLIC
}

/// A tool registered from SinoBee (e.g. a database browser). The manifest never contains secrets.
model Tool {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  kind          String         @default("database")
  description   String         @default("")
  visibility    ToolVisibility @default(PRIVATE)
  latestVersion String?
  installs      Int            @default(0)
  ratingAvg     Float          @default(0)
  ratingCount   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  versions ToolVersion[]
  ratings  ToolRating[]

  @@unique([ownerId, name])
  @@index([visibility, updatedAt])
}

model ToolVersion {
  id           String       @id @default(cuid())
  toolId       String
  tool         Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  version      String
  /// "sha256:<hex>" of the canonical TOOL.json
  contentHash  String
  manifest     Json
  /// storage object holding TOOL.json (Boltchain-backed)
  objectKey    String?
  /// published for everyone (reviewed) vs. for the owner only — a tool that goes public never exposes its private versions
  public       Boolean      @default(false)
  /// public versions go through review; private ones are APPROVED immediately
  status       ReviewStatus @default(APPROVED)
  scanFindings Json         @default("[]")
  reviewNote   String?
  reviewerId   String?
  reviewer     User?        @relation("toolReviewer", fields: [reviewerId], references: [id])
  reviewedAt   DateTime?
  anchorCode   String?
  publishedAt  DateTime     @default(now())

  @@unique([toolId, version])
}

model ToolRating {
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars     Int
  updatedAt DateTime @updatedAt

  @@id([toolId, userId])
}

// ───────────────────────── End-to-end encrypted vault ─────────────────────────

/// Wrapped vault key: the user's X25519 private key encrypted with a key derived (scrypt) from their passphrase.
/// The server never sees the passphrase or the plaintext key.
model VaultKey {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey String
  /// base64 { v, kdf:{n,r,p,salt}, iv, ct } (AES-256-GCM)
  wrapped   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An encrypted blob (e.g. private tool connection settings + secrets) only the owner can open
/// The vault private key sealed to one device's X25519 key (deleted when the device is signed out)
model VaultDeviceKey {
  deviceId  String   @id
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId    String
  /// sealed envelope {v, epk, iv, ct}
  wrapped   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model VaultPack {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// storage object key of the ciphertext
  objectKey String
  size      Int
  sha256    String
  /// increments on every write; clients send the version they read (optimistic concurrency)
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// ───────────────────────── Conversation sharing ─────────────────────────

enum ShareVisibility {
  /// anyone with the link (unlisted)
  LINK
  /// signed-in users; optionally only the CAFECA accounts in ShareAccess
  LOGIN
  /// listed publicly
  PUBLIC
}

model ConversationShare {
  id          String          @id
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  visibility  ShareVisibility @default(LINK)
  /// LOGIN only: restrict to ShareAccess accounts
  restricted  Boolean         @default(false)
  /// storage object key of the share JSON (messages, already redacted by the client)
  objectKey   String
  contentHash String
  messages    Int
  model       String?
  /// "chat" (a conversation) or "doc" (a report or interactive page a skill made: `entry` is its main file)
  kind        String          @default("chat")
  entry       String?
  /// summary for link previews (Open Graph / X cards); shown only for LINK and PUBLIC shares
  description String?
  /// storage key of the 1200×630 link-preview picture
  ogKey       String?
  views       Int             @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  anchorCode  String?
  createdAt   DateTime        @default(now())

  access ShareAccess[]
  files  ShareFile[]

  @@index([ownerId, createdAt])
  @@index([visibility, createdAt])
}

model ShareAccess {
  shareId String
  share   ConversationShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  /// CAFECA identity contract address (lowercase)
  account String

  @@id([shareId, account])
  @@index([account])
}

model ShareFile {
  id        String            @id @default(cuid())
  shareId   String
  share     ConversationShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  name      String
  objectKey String
  size      Int
  sha256    String
  mime      String
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([targetType, targetId])
}

// ───────────────────────── Storage on Boltchain ─────────────────────────

enum StorageStatus {
  /// stored in the mirror only, waiting for the Boltchain worker
  PENDING
  /// sealed with bolt-vault, blocks hosted, deal created
  STORED
  /// deal ended or could not be created; mirror still serves it
  FAILED
  /// deleted: object key destroyed (crypto-shred) and deal cancelled
  DELETED
}

/// One logical object (skill bundle, task artifact, tool manifest, vault pack, share).
/// Bytes are sealed with bolt-vault for a per-object X25519 recipient whose private key is
/// encrypted with the site master key; destroying `recipientKey` makes the on-chain copy unreadable.
model StorageObject {
  key          String        @id
  kind         String
  size         BigInt
  sha256       String
  keccak       String
  contentType  String        @default("application/octet-stream")
  status       StorageStatus @default(PENDING)
  /// bolt-vault envelope CID (raw CIDv1) and deal index root (dag-cbor CIDv1)
  envelopeCid  String?
  dealRoot     String?
  dealId       BigInt?
  /// none | active | cancelled (ends after the current epoch) | closed (refund settled)
  dealState    String        @default("none")
  blocks       Int?
  dealSize     BigInt?
  replicas     Int?
  endEpoch     BigInt?
  /// BOLT paid by the site wallet (wei, decimal string)
  paidWei      String?
  txHash       String?
  /// AES-256-GCM(site master key, X25519 private key), base64
  recipientKey String?
  /// keep the mirror copy (local/S3) for fast reads
  mirrored     Boolean       @default(true)
  /// copies wanted (policy by kind; shares 2, others 3)
  wantReplicas Int?
  /// stop renewing after this time (e.g. a share's expiry); the deal is sized to end then
  keepUntil    DateTime?
  /// deleted, but the key is kept and the deal runs until then (public tools: 90 days after takedown)
  deleteAfter  DateTime?
  lastAuditAt  DateTime?
  error        String?
  attempts     Int           @default(0)
  nextTryAt    DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([status, nextTryAt])
  @@index([dealState, endEpoch])
}

/// Content hashes notarized with the Boltchain Certificates contract (third-party verifiable)
model Anchor {
  id          String    @id @default(cuid())
  /// what was anchored: tool-version | share | skill-version | artifact
  targetType  String
  targetId    String
  /// 16-char Crockford base32 certificate code (null until issued)
  code        String?   @unique
  salt        String
  /// [{name, sha256, keccak, size}]
  files       Json
  /// public certificate: the files themselves are kept on Boltchain (content read from the target when issuing)
  publicFiles Boolean   @default(false)
  root        String?
  txHash      String?
  status      String    @default("pending")
  error       String?
  attempts    Int       @default(0)
  nextTryAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  issuedAt    DateTime?

  @@unique([targetType, targetId])
  @@index([status, nextTryAt])
}

// ───────────────────────── Crowdfunding ─────────────────────────

enum PledgeSource {
  CARD
  POINTS
  QUOTA
}

enum PledgeStatus {
  /// card: bound, not charged yet; points / quota: already deducted
  ACTIVE
  CHARGED
  /// card charge failed (retried until the grace period ends)
  FAILED
  /// withdrawn by the backer before charging
  CANCELLED
  /// campaign ended without funding: points / quota given back, card never charged
  RELEASED
  /// card charge refunded (funding fell short after charging)
  REFUNDED
}

/**
 * One pledge action: shares × share price, paid with a saved card (charged later), points or subscription quota
 */
model Pledge {
  id            String       @id @default(cuid())
  taskId        String
  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source        PledgeSource
  shares        Int
  amountTwd     Int
  status        PledgeStatus @default(ACTIVE)
  cardId        String?
  card          SavedCard?   @relation(fields: [cardId], references: [id])
  /// the CROWD_PLEDGE payment that charged it (one per backer and task)
  paymentId     String?
  payment       Payment?     @relation(fields: [paymentId], references: [id])
  usageLedgerId String?      @unique
  /// leftover given back at settlement (points for CARD / POINTS, quota for QUOTA)
  returnedTwd   Int          @default(0)
  /// CARD pledges: part paid with points (less than one share); the card is charged amountTwd − pointsTwd
  pointsTwd     Int          @default(0)
  /// pledged during a top-up round (waits for that round's goal)
  topup         Boolean      @default(false)
  /// version of the crowdfunding terms the backer agreed to
  termsVersion  Int?
  error         String?
  createdAt     DateTime     @default(now())
  chargedAt     DateTime?
  updatedAt     DateTime     @updatedAt

  @@index([taskId, status])
  @@index([userId, createdAt])
}

/**
 * A card saved with Oen (token checkout). The token arrives only through the token notification.
 */
model SavedCard {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Oen checkout-token id (also the id in the token notification)
  bindingId   String    @unique
  /// sealed with the settings key; null until the notification arrives
  tokenSealed String?
  last4       String?
  /// card network (visa, mastercard, jcb, amex, unionpay, diners, discover); null when the gateway did not say
  brand       String?
  /// pending | active | failed | removed
  status      String    @default("pending")
  /// bound in test mode (Oen testing environment): only usable while the site is in test mode
  sandbox     Boolean   @default(false)
  error       String?
  createdAt   DateTime  @default(now())
  activatedAt DateTime?
  removedAt   DateTime?
  pledges     Pledge[]

  @@index([userId, status])
}

/**
 * Platform points: 1 point = 1 TWD, only for crowdfunding pledges, not transferable, no cash-out
 */
model PointLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  /// leftover | pledge | release | platform | admin | llm_usage (model calls paid with points, 1:1)
  reason    String
  /// idempotency key, e.g. "leftover:<pledgeId>"
  ref       String?  @unique
  taskId    String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum FileVisibility {
  /// anyone who can see the task
  PUBLIC
  /// backers and the proposer
  BACKERS
  /// only the agent (and the proposer)
  AGENT
}

/**
 * Reference files uploaded with a crowdfunding proposal; copied into the task's inputs/ folder
 */
model TaskInputFile {
  id          String         @id @default(cuid())
  taskId      String
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  key         String
  filename    String
  contentType String
  sizeBytes   BigInt
  sha256      String
  visibility  FileVisibility @default(BACKERS)
  createdAt   DateTime       @default(now())
  deletedAt   DateTime?

  @@index([taskId])
}

/**
 * A backer's acceptance vote, weighted by the shares they paid for (collected pledges)
 */
model AcceptanceVote {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// review round (0 = first review, n = after the n-th rework)
  round     Int      @default(0)
  approve   Boolean
  reason    String?
  shares    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([taskId, userId, round])
}

/**
 * Spec versions published while the campaign is open (v1 = the one funding opened with)
 */
model SpecRevision {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  version   Int
  spec      Json
  note      String?
  createdAt DateTime @default(now())

  @@unique([taskId, version])
}

/**
 * The proposal screening checklist: yes/no items grouped in dimensions. Every item must be answered "yes" for a
 * proposal to open. Published versions are public (crowdfunding terms) and never change; publishedAt = null is the
 * admins' working draft.
 */
model ChecklistVersion {
  id          String    @id @default(cuid())
  /// 1, 2, … for published versions; 0 for the draft
  version     Int       @default(0)
  /// [{id, dimension, text}]
  items       Json
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([publishedAt, version])
}

/**
 * Every published text of a legal document, as the exact markdown shown, notarized on Boltchain
 */
model LegalVersion {
  id         String   @id @default(cuid())
  /// terms | privacy | refunds | crowd
  doc        String
  locale     String
  version    Int
  markdown   String
  sha256     String
  /// Boltchain certificate code once issued
  anchorCode String?
  createdAt  DateTime @default(now())

  @@unique([doc, locale, version])
  @@unique([doc, locale, sha256])
}

/// One evaluation published from SinoBee (`sinobee eval publish`), scored with SFS v1: one thing under test - a
/// skill's thinking + execution model combination (kind "skill") or one model doing everything in a domain (kind
/// "model") - on one suite, graded by one judge, over n trials. The listing columns are computed from the trials.
model BenchEval {
  id              Int           @id @default(autoincrement())
  publisherId     String
  publisher       User          @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  /// "skill" | "model"
  kind            String
  /// the skill (kind "skill") or the domain (kind "model")
  subject         String
  subjectVersion  String        @default("")
  title           String
  summary         String        @default("")
  suite           String
  suiteHash       String
  inputHash       String?
  thinkingModel   String
  executionModel  String
  judgeModel      String
  judge2Model     String?
  clientVersion   String?
  testedAt        DateTime
  testedUntil     DateTime?
  trials          Int
  /// {tasks: [{id, title, prompt, questions, weights, trials: [...]}], threshold, judgeCheck, judge2Agree, creativity, runs}
  data            Json
  meanScore       Float
  stdErr          Float
  fairScore       Float
  qualified       Int
  critFails       Int
  medianSeconds   Float?
  p90Seconds      Float?
  costPerPass     Float?
  creativityWins  Int?
  creativityTotal Int?
  hidden          Boolean       @default(false)
  /// "public" | "private" (only the publisher sees a private report; it is in no list or ranking)
  visibility      String        @default("public")
  /// the evaluation skill that wrote the suite ("eval-authoring@1.0.0")
  evaluator       String?
  suiteId         String?
  benchSuite      BenchSuite?   @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  /// the published skill version a public skill evaluation is about
  skillVersionId  String?
  skillVersion    SkillVersion? @relation(fields: [skillVersionId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([kind, subject])
  @@index([suiteHash])
}

/// An evaluation suite written by an evaluation skill (SinoBee evals/authoring.py), shared so that others can run the
/// same questions on other model combinations. The hash is recomputed here exactly as SinoBee computes it.
model BenchSuite {
  id                      String        @id @default(cuid())
  hash                    String        @unique
  kind                    String        @default("skill")
  /// the skill under test (its SinoBee name)
  subject                 String
  subjectVersion          String        @default("")
  skillVersionId          String?
  skillVersion            SkillVersion? @relation("suiteSkill", fields: [skillVersionId], references: [id], onDelete: SetNull)
  evaluator               String        @default("")
  evaluatorVersion        String        @default("")
  evaluatorSkillVersionId String?
  evaluatorSkillVersion   SkillVersion? @relation("suiteEvaluator", fields: [evaluatorSkillVersionId], references: [id], onDelete: SetNull)
  title                   String        @default("")
  /// suite.json as SinoBee stores it: {title, skill, bench, graders, inputs, anchors}
  suite                   Json
  /// {"inputs/<id>/<file>": text} - de-identified test inputs
  inputs                  Json
  createdById             String
  createdBy               User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  reportCount             Int           @default(0)
  hidden                  Boolean       @default(false)
  createdAt               DateTime      @default(now())

  evals BenchEval[]

  @@index([subject])
}

/// Anonymous task outcomes SinoBee sends when the user turned on "回報匿名統計" (off by default): no user, no
/// session, no content, only the day. Feeds the completion rate in model allocation (lib/llm/route.ts, plan P5).
model RouteStat {
  id        String  @id @default(cuid())
  /// yyyy-mm-dd (UTC); no time of day
  day       String
  modelId   String
  /// chat | page | code | research | data | other
  taskKind  String  @default("other")
  /// a published skill's name, else null (private skill names are not kept)
  skill     String?
  /// done | incomplete | failed | stopped
  outcome   String
  seconds   Float   @default(0)
  tokensIn  Int     @default(0)
  tokensOut Int     @default(0)
  retries   Int     @default(0)
  cutOff    Boolean @default(false)

  @@index([modelId, taskKind])
  @@index([day])
}
