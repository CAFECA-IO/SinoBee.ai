  "graders": [
   {
    "type": "file_exists",
    "path": "minutes.md",
    "label": "產出會議紀錄檔",
    "category": "完整性",
    "critical": true,
    "owner": "execution",
    "stage": "output"
   },
   {
    "type": "file_regex",
    "path": "minutes.md",
    "pattern": "(?m)^#+\\s*待辦",
