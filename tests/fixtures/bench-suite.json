    "label": "成果沒有格式錯誤",
    "category": "格式",
    "owner": "execution",
    "stage": "output"
   },
   {
    "type": "file_not_regex",
    "path": "minutes.md",
    "pattern": "TODO|待補",
    "label": "沒有留下未完成標記",
    "category": "格式",
    "owner": "execution",
    "stage": "output"
   },
   {
    "type": "status",
    "is": "done",
    "label": "任務完成",
    "category": "流程健康",
