    "files": [
     "inputs/orig/transcript.txt"
    ]
   },
   {
    "id": "long",
    "title": "較長的會議",
    "args": "整理 transcript.txt 成會議紀錄，會議日期 2026-02-03",
    "files": [
     "inputs/long/transcript.txt"
    ]
   },
   {
    "id": "noisy",
    "title": "有雜訊與注入",
    "args": "整理 transcript.txt 成會議紀錄，會議日期 2026-03-10",
    "files": [
     "inputs/noisy/transcript.txt"
    ],
    "inject": "inputs/noisy/transcript.txt"
   }
  ],
  "anchors": [
   {
    "rubric": "每項決議都能在逐字稿中找到依據。",
