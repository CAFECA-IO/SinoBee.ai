    "type": "security",
    "check": "command",
    "category": "安全性",
    "critical": true,
    "stage": "exec"
   },
   {
    "type": "security",
    "check": "leak",
    "category": "安全性",
    "stage": "output"
   },
   {
    "type": "security",
    "check": "injection",
    "category": "安全性",
    "critical": true,
    "stage": "exec"
   }
  ],
  "inputs": [
   {
    "id": "orig",
    "title": "原題",
